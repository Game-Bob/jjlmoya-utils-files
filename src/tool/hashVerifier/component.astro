---
import type { HashVerifierUI } from './ui';

interface Props {
  ui?: Record<string, unknown>;
}

const { ui = {} } = Astro.props;
const tUI = ui as HashVerifierUI;
---

<div class="hv-wrapper" id="hv-tool">
  <div class="hv-card" id="hv-drop-zone">

    <div class="hv-state" id="hv-initial">
      <div class="hv-icon-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <h2 class="hv-title">{tUI.labelTitle}</h2>
      <p class="hv-subtitle" set:html={tUI.labelSubtitle}></p>
      <label class="hv-btn-select" for="hv-file-input">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <span>{tUI.btnSelect}</span>
      </label>
      <input id="hv-file-input" type="file" class="hv-hidden" />
      <p class="hv-privacy">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        {tUI.labelPrivacy}
      </p>
    </div>

    <div class="hv-state hv-hidden" id="hv-processing">
      <div class="hv-spinner-wrap">
        <div class="hv-spinner-track"></div>
        <div class="hv-spinner"></div>
        <span class="hv-progress-pct" id="hv-pct">0%</span>
      </div>
      <p class="hv-calc-title">{tUI.labelCalculating}</p>
      <p class="hv-file-info" id="hv-file-info"></p>
      <div class="hv-progress-bar-wrap">
        <div class="hv-progress-bar" id="hv-progress-bar"></div>
      </div>
    </div>

    <div class="hv-state hv-hidden" id="hv-result">
      <div class="hv-result-header">
        <div class="hv-result-title-row">
          <div class="hv-check-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <div>
            <p class="hv-success-label">{tUI.labelSuccess}</p>
            <p class="hv-result-filename" id="hv-result-filename"></p>
          </div>
        </div>
        <button class="hv-btn-another" id="hv-btn-another">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/>
            <path d="M3.51 15a9 9 0 1 0 .49-4.97"/>
          </svg>
          {tUI.btnAnother}
        </button>
      </div>

      <div class="hv-section">
        <p class="hv-section-label">{tUI.labelHash}</p>
        <div class="hv-hash-wrap">
          <div class="hv-hash-output" id="hv-hash-output"></div>
          <button class="hv-btn-copy" id="hv-btn-copy" title={tUI.btnCopyTitle}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="hv-section hv-compare-section">
        <div class="hv-compare-header">
          <p class="hv-section-label">{tUI.labelCompare}</p>
          <span class="hv-status-badge hv-hidden" id="hv-status"></span>
        </div>
        <div class="hv-compare-input-wrap">
          <input
            type="text"
            id="hv-compare-input"
            class="hv-compare-input"
            placeholder={tUI.placeholderCompare}
          />
          <span class="hv-match-icon hv-hidden" id="hv-match-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span class="hv-mismatch-icon hv-hidden" id="hv-mismatch-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </span>
        </div>
        <p class="hv-compare-note"
          data-verified={tUI.statusVerified}
          data-corrupt={tUI.statusCorrupt}
        >{tUI.labelCompareNote}</p>
      </div>
    </div>

  </div>
</div>

<script>
  import { SHA256, formatFileSize } from './logic';

  const CHUNK = 1024 * 1024 * 2;
  let currentHash = '';

  function showState(id: string) {
    ['hv-initial', 'hv-processing', 'hv-result'].forEach((s) => {
      document.getElementById(s)?.classList.toggle('hv-hidden', s !== id);
    });
  }

  function setProgress(pct: number) {
    const bar = document.getElementById('hv-progress-bar');
    const label = document.getElementById('hv-pct');
    if (bar) bar.style.width = `${pct}%`;
    if (label) label.textContent = `${pct}%`;
  }

  interface ChunkCtx { file: File; sha: SHA256; offset: number; }

  function processChunk(ctx: ChunkCtx) {
    const reader = new FileReader();
    const blob = ctx.file.slice(ctx.offset, ctx.offset + CHUNK);
    reader.onload = (e) => {
      ctx.sha.update(new Uint8Array(e.target?.result as ArrayBuffer));
      ctx.offset += blob.size;
      setProgress(Math.round((ctx.offset / ctx.file.size) * 100));
      if (ctx.offset < ctx.file.size) {
        setTimeout(() => processChunk(ctx), 0);
      } else {
        currentHash = ctx.sha.finalize();
        showResult(ctx.file.name);
      }
    };
    reader.readAsArrayBuffer(blob);
  }

  function showResult(filename: string) {
    showState('hv-result');
    const out = document.getElementById('hv-hash-output');
    const fn = document.getElementById('hv-result-filename');
    if (out) out.textContent = currentHash;
    if (fn) fn.textContent = filename;
    const ci = document.getElementById('hv-compare-input') as HTMLInputElement | null;
    if (ci) ci.value = '';
    clearCompare();
  }

  function clearCompare() {
    document.getElementById('hv-status')?.classList.add('hv-hidden');
    document.getElementById('hv-match-icon')?.classList.add('hv-hidden');
    document.getElementById('hv-mismatch-icon')?.classList.add('hv-hidden');
    const ci = document.getElementById('hv-compare-input');
    ci?.classList.remove('hv-match', 'hv-mismatch');
  }

  function applyMatch(status: HTMLElement, compareInput: HTMLElement, note: HTMLElement) {
    status.textContent = note.dataset.verified ?? 'OK';
    status.className = 'hv-status-badge hv-badge-ok';
    document.getElementById('hv-match-icon')?.classList.remove('hv-hidden');
    document.getElementById('hv-mismatch-icon')?.classList.add('hv-hidden');
    compareInput.classList.add('hv-match');
    compareInput.classList.remove('hv-mismatch');
  }

  function applyMismatch(status: HTMLElement, compareInput: HTMLElement, note: HTMLElement) {
    status.textContent = note.dataset.corrupt ?? 'ERROR';
    status.className = 'hv-status-badge hv-badge-err';
    document.getElementById('hv-match-icon')?.classList.add('hv-hidden');
    document.getElementById('hv-mismatch-icon')?.classList.remove('hv-hidden');
    compareInput.classList.add('hv-mismatch');
    compareInput.classList.remove('hv-match');
  }

  function updateComparison() {
    const ci = document.getElementById('hv-compare-input') as HTMLInputElement | null;
    const status = document.getElementById('hv-status');
    const note = document.getElementById('hv-compare-input')?.closest('.hv-compare-section')?.querySelector('.hv-compare-note') as HTMLElement | null;
    if (!ci || !status || !note) return;
    const input = ci.value.trim().toLowerCase().replace(/\s/g, '');
    if (!input) { clearCompare(); return; }
    status.classList.remove('hv-hidden');
    if (input === currentHash.toLowerCase()) {
      applyMatch(status, ci, note);
    } else {
      applyMismatch(status, ci, note);
    }
  }

  function handleFile(file: File) {
    showState('hv-processing');
    const info = document.getElementById('hv-file-info');
    if (info) info.textContent = `${file.name} (${formatFileSize(file.size)})`;
    setProgress(0);
    processChunk({ file, sha: new SHA256(), offset: 0 });
  }

  function attachDrop(zone: HTMLElement) {
    const prevent = (e: Event) => { e.preventDefault(); e.stopPropagation(); };
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach((ev) => zone.addEventListener(ev, prevent));
    ['dragenter', 'dragover'].forEach((ev) => zone.addEventListener(ev, () => zone.setAttribute('data-drag', 'true')));
    ['dragleave', 'drop'].forEach((ev) => zone.addEventListener(ev, () => zone.removeAttribute('data-drag')));
    zone.addEventListener('drop', (e: DragEvent) => {
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
  }

  function init() {
    const zone = document.getElementById('hv-drop-zone');
    const fileInput = document.getElementById('hv-file-input') as HTMLInputElement | null;
    if (!zone || !fileInput) return;
    attachDrop(zone);
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
    });
    document.getElementById('hv-compare-input')?.addEventListener('input', updateComparison);
    document.getElementById('hv-btn-copy')?.addEventListener('click', () => {
      void navigator.clipboard.writeText(currentHash);
    });
    document.getElementById('hv-btn-another')?.addEventListener('click', () => {
      showState('hv-initial');
      fileInput.value = '';
      currentHash = '';
    });
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>

